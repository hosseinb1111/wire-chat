{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "wire-chat",

  "main": "worker.js",

  "compatibility_date": "2026-08-14",

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    }
  ]
}